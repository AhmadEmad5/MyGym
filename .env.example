# Firebase Client Configuration
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# AI Integration (Google Gemini API)
# The Gemini API key is NEVER read by the browser. It is held server-side by the
# `generateGeminiContent` Cloud Function. See functions/.env.example.

# Administrator Account
# VITE_ADMIN_EMAIL is only used as a display fallback; it grants no access.
VITE_ADMIN_EMAIL="admin@example.com"
