# Firebase Client Configuration
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# Firebase App Check (reCAPTCHA Enterprise site key).
# Public by design — unlike VITE_FIREBASE_API_KEY this is not a credential, and
# the browser must ship it to obtain App Check tokens. Create a Web-type key on
# https://console.cloud.google.com/security/recaptcha, register it in the Firebase
# console under Security > App Check, and list every serving domain there.
# Leave EMPTY to skip App Check init: the app still runs, but every call to
# generateGeminiContent is rejected with HTTP 401 (enforceAppCheck: true).
VITE_FIREBASE_APP_CHECK_SITE_KEY="your_recaptcha_enterprise_site_key"

# AI Integration (Google Gemini API)
# The Gemini API key is NEVER read by the browser. It is held server-side by the
# `generateGeminiContent` Cloud Function. See functions/.env.example.

# Administrator Account
# VITE_ADMIN_EMAIL is only used as a display fallback; it grants no access.
VITE_ADMIN_EMAIL="admin@example.com"
