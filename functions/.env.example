# Google Gemini API Key for Server-side Cloud Functions
# NEVER expose this as a VITE_ variable: Vite inlines VITE_* values into the
# public client bundle, which would leak the key to every visitor.
# Preferred: store it in Secret Manager (firebase functions:secrets:set GEMINI_API_KEY)
# Local development fallback: place it in functions/.env (git-ignored) instead.
GEMINI_API_KEY="replace_with_your_gemini_api_key"

# Maximum free AI requests per user per day (Defaults to 10 if omitted)
DAILY_FREE_AI_LIMIT=10

# Comma-separated list of browser origins allowed to call generateGeminiContent.
# Defence in depth only; App Check is the real control. Leave empty (the default)
# to disable the check, which is what the emulator and CI need. Requests with no
# Origin header at all (Capacitor/Electron/native) are always allowed past this
# check and are governed by App Check instead.
# ALLOWED_ORIGINS=https://your-app.web.app,https://your-domain.com

# ---------------------------------------------------------------------------
# CLIENT ACTION REQUIRED BEFORE DEPLOYING App Check
# ---------------------------------------------------------------------------
# generateGeminiContent is registered with `enforceAppCheck: true`. Until the
# client initialises App Check, EVERY call is rejected by the Firebase Functions
# runtime with HTTP 401 (before the handler body runs) and the AI features in the
# app stop working for all users. Do not deploy this change on its own.
#
# Required client change (src/lib/firebase.ts):
#
#   import { initializeAppCheck, ReCaptchaEnterpriseProvider } from 'firebase/app-check';
#   const appCheckSiteKey = import.meta.env.VITE_FIREBASE_APP_CHECK_SITE_KEY;
#   if (appCheckSiteKey) {
#     initializeAppCheck(app, {
#       provider: new ReCaptchaEnterpriseProvider(appCheckSiteKey),
#       isTokenAutoRefreshEnabled: true,
#     });
#   }
#
# Plus console setup: register a reCAPTCHA Enterprise key in Firebase App Check
# and add every serving domain. src/lib/gemini.ts needs no change -- the SDK
# attaches the App Check header to httpsCallable automatically once the provider
# is initialised.
# ---------------------------------------------------------------------------

# Maximum AI requests per user per minute, applied to every tier including PRO.
# Acts as a burst guard so the callable cannot be used as an open relay. (Defaults to 10)
MAX_AI_REQUESTS_PER_MINUTE=10

# Maximum accepted size of a base64 image payload, in characters.
# 800,000 characters is roughly a 600 KB image. The app compresses meal photos
# to 800px JPEG at quality 0.72 (~35-100 KB), so this leaves ample headroom
# while staying far below the 10 MB callable request limit. (Defaults to 800000)
MAX_IMAGE_BASE64_CHARS=800000
