# Google Gemini API Key for Server-side Cloud Functions
# NEVER expose this as a VITE_ variable: Vite inlines VITE_* values into the
# public client bundle, which would leak the key to every visitor.
# Preferred: store it in Secret Manager (firebase functions:secrets:set GEMINI_API_KEY)
# Local development fallback: place it in functions/.env (git-ignored) instead.
GEMINI_API_KEY="replace_with_your_gemini_api_key"

# Maximum free AI requests per user per day (Defaults to 10 if omitted)
DAILY_FREE_AI_LIMIT=10

# Maximum AI requests per user per minute, applied to every tier including PRO.
# Acts as a burst guard so the callable cannot be used as an open relay. (Defaults to 10)
MAX_AI_REQUESTS_PER_MINUTE=10

# Maximum accepted size of a base64 image payload, in characters.
# 800,000 characters is roughly a 600 KB image. The app compresses meal photos
# to 800px JPEG at quality 0.72 (~35-100 KB), so this leaves ample headroom
# while staying far below the 10 MB callable request limit. (Defaults to 800000)
MAX_IMAGE_BASE64_CHARS=800000
